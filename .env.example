# MongoDB connection string for the blog database.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true

# HTTP Basic credentials guarding /admin and /api/admin/*.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Optional. HMAC key for the admin session cookie; derived from ADMIN_PASSWORD when unset.
# Set this explicitly so rotating the password does not silently invalidate sessions.
ADMIN_SESSION_SECRET=

# Canonical public origin used for canonical/og:url tags. No trailing slash.
# Without it those tags fall back to the request origin, which on Vercel is the
# preview deployment URL rather than the production domain.
PUBLIC_SITE_URL=https://example.com
