---
import '@fontsource-variable/plus-jakarta-sans';
import '@/styles/global.css';
import '@/styles/animations.css';
import { ClientRouter } from 'astro:transitions';
import SeoTags from '@/components/shared/SeoTags.astro';
import Preloader from '@/components/shared/Preloader.astro';
import Header from '@/components/shared/Header.astro';
import ContactBar from '@/components/shared/ContactBar.astro';
import { SITE, absoluteUrl } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of the image that will be the LCP element. */
  preloadImage?: string;
}

const { title, description = SITE.description, preloadImage } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname, Astro.url, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoTags title={title} description={description} canonical={canonical} />
    {/* Starts the LCP image download during head parsing, not after layout. */}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <ClientRouter />
  </head>
  <body>
    <Preloader />
    <Header />
    <slot />
    <ContactBar />
  </body>
</html>
