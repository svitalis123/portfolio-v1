---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/homepage/HeroSection.astro';
import FeaturedProjects from '@/components/homepage/FeaturedProjects.astro';
import SkillsProject from '@/components/homepage/SkillsProject.astro';
import BlogPosts from '@/components/homepage/BlogPosts.astro';
import Certifications from '@/components/homepage/Certifications.astro';
import { listPosts } from '@/services/BlogDataService';
import { PROJECTS } from '@/data/projects';
import { SKILLS } from '@/data/skills';
import { HERO_IMAGES } from '@/data/hero';

const blogPosts = await listPosts({ limit: 3 });
---

<Layout title="Vitalis" preloadImage={HERO_IMAGES[0]}>
  <main class="bg-[#201d1b] w-full overflow-hidden text-[#ecc7bc]">
    <HeroSection />

    <!-- Width tracks the project count so adding a project cannot silently
         desynchronise the horizontal scroll track from its panels. -->
    <div id="projects" class="my_container" style={`width: ${PROJECTS.length * 100}%`}>
      <FeaturedProjects projects={PROJECTS} />
    </div>

    <BlogPosts blogPosts={blogPosts} />
    <SkillsProject skills={SKILLS} />
    <Certifications />
  </main>
</Layout>

<style>
  .my_container {
    height: 100vh;
    display: flex;
    flex-wrap: nowrap;
  }
</style>

<style is:global>
  /* GSAP pins .my_container, which needs the document itself to be the scroller. */
  html {
    overflow-y: scroll;
    height: 100%;
    -webkit-overflow-scrolling: touch;
  }

  body {
    overflow-y: visible;
    position: relative;
    height: unset;
  }
</style>

<script>
  import { watchForProjects } from '@/scripts/horizontalScroll';
  import { initProjectsAnchor } from '@/scripts/projectsAnchor';

  initProjectsAnchor();
  document.addEventListener('astro:page-load', watchForProjects);
</script>
