---
import '@fontsource-variable/plus-jakarta-sans';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import RenderIndividualBlog from '@/components/editor/EditorHomepage/RenderIndividualBlog';
import BlogHeader from '@/components/shared/BlogHeader';
import SeoTags from '@/components/shared/SeoTags.astro';
import { getPostBySlug } from '@/services/BlogDataService';
import { SITE, absoluteUrl } from '@/lib/site';

const { slug } = Astro.params;

const post = slug ? await getPostBySlug(slug) : null;
if (!post) {
  return Astro.redirect('/blogs', 302);
}

// A post reached by its legacy ObjectId gets its canonical slug URL, not the id.
const canonical = absoluteUrl(`/blogs/${post.slug}`, Astro.url, Astro.site);
const title = post.seoTitle || post.title;
const description = post.seoDescription || post.excerpt || SITE.description;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoTags
      title={title}
      description={description}
      canonical={canonical}
      type="article"
      author={post.author}
      publishDate={post.publishDate}
      keywords={post.tags.length > 0 ? post.tags.join(', ') : undefined}
    />
    <ClientRouter />
  </head>
  <body class="bg-[#201d1b] min-h-screen flex flex-col">
    <BlogHeader />
    <main class="flex-grow">
      <div class="container mx-auto px-4">
        <RenderIndividualBlog blogData={post} client:idle />
      </div>
    </main>
  </body>
</html>
