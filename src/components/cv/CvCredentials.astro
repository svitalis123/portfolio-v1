---
import { ExternalLink } from 'lucide-react';
import { CV_CREDENTIALS } from '@/data/cv';

interface Props {
  /** 2 on the CV page, 3 on the wider homepage section. */
  columns?: 2 | 3;
}

const { columns = 2 } = Astro.props;
const gridClass = columns === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---

<ul class={`grid grid-cols-1 ${gridClass} gap-5 list-none p-0`}>
  {
    CV_CREDENTIALS.map((credential) => {
      const Tag = credential.url ? 'a' : 'div';
      const linkProps = credential.url
        ? { href: credential.url, target: '_blank', rel: 'noopener noreferrer' }
        : {};

      return (
        <li>
          <Tag
            {...linkProps}
            class={`cert-card flex h-full flex-col overflow-hidden rounded-lg border border-[#ecc7bc]/12 bg-[#2a2624] no-underline ${
              credential.url ? 'cert-link' : ''
            }`}
          >
            {credential.image ? (
              /* A fixed ratio with object-contain keeps every card the same height
                 and still shows each certificate whole rather than cropping it. */
              <img
                src={credential.image}
                alt={`${credential.name} certificate`}
                width="1000"
                height="750"
                loading="lazy"
                decoding="async"
                class="block aspect-[4/3] w-full border-b border-[#ecc7bc]/10 bg-white object-contain"
              />
            ) : (
              <div class="flex aspect-[4/3] w-full items-center justify-center border-b border-[#ecc7bc]/10 bg-[#201d1b] text-[10px] uppercase tracking-[0.2em] text-[#ecc7bc]/25">
                No preview available
              </div>
            )}

            <div class="flex flex-1 flex-col p-4">
              <p class="text-sm font-semibold leading-snug text-[#ecc7bc]">{credential.name}</p>
              <p class="mt-1.5 text-xs text-[#ecc7bc]/55">
                {credential.issuer}
                {credential.date && <span> · {credential.date}</span>}
              </p>
              {credential.url && (
                <span class="mt-2.5 inline-flex items-center gap-1 text-xs text-[#e34b3a]">
                  View certificate
                  <ExternalLink size={12} aria-hidden="true" />
                </span>
              )}
            </div>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .cert-card {
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .cert-link:hover {
    transform: translateY(-4px);
    border-color: rgba(227, 75, 58, 0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-link:hover { transform: none; }
  }
</style>
