---
import { CV_EDUCATION } from '@/data/cv';
---

{
  CV_EDUCATION.map((entry) => (
    <article class="mb-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h3 class="text-base font-bold text-[#ecc7bc]">
          {entry.qualification}
          <span class="text-[#e34b3a] font-medium"> · {entry.institution}</span>
        </h3>
        <span class="text-sm text-[#ecc7bc]/50 whitespace-nowrap">{entry.period}</span>
      </div>
      <p class="mt-1.5 text-sm text-[#ecc7bc]/75">{entry.detail}</p>
    </article>
  ))
}
