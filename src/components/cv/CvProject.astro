---
import type { CvProject } from '@/data/cv';

interface Props {
  project: CvProject;
}

const { project } = Astro.props;
---

<article class="mb-9">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <h3 class="text-lg font-bold text-[#ecc7bc]">
      {
        project.url ? (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#e34b3a] transition-colors no-underline"
          >
            {project.name}
          </a>
        ) : (
          project.name
        )
      }
    </h3>
    <span class="text-sm text-[#e34b3a]">{project.role}</span>
    {project.org && <span class="text-sm text-[#ecc7bc]/50">· {project.org}</span>}
  </div>

  <p class="mt-1.5 text-sm italic text-[#ecc7bc]/60">{project.summary}</p>

  <ul class="mt-3 space-y-1.5 list-none p-0">
    {
      project.bullets.map((bullet) => (
        <li class="relative pl-5 text-sm leading-relaxed text-[#ecc7bc]/85">
          <span class="absolute left-0 top-[0.55em] h-1 w-1 rounded-full bg-[#e34b3a]" />
          {bullet}
        </li>
      ))
    }
  </ul>

  <ul class="mt-3 flex flex-wrap gap-2 list-none p-0">
    {
      project.stack.map((tech) => (
        <li class="rounded-full bg-[#492c49] px-2.5 py-0.5 text-xs text-[#ecc7bc]">{tech}</li>
      ))
    }
  </ul>
</article>
