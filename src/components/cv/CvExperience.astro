---
import { CV_EXPERIENCE } from '@/data/cv';
---

{
  CV_EXPERIENCE.map((role) => (
    <article class="mb-9">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h3 class="text-lg font-bold text-[#ecc7bc]">
          {role.title} <span class="text-[#e34b3a] font-medium">· {role.org}</span>
        </h3>
        <span class="text-sm text-[#ecc7bc]/50 whitespace-nowrap">{role.period}</span>
      </div>

      <p class="mt-1.5 text-sm italic text-[#ecc7bc]/60">{role.context}</p>

      <ul class="mt-3 space-y-1.5 list-none p-0">
        {role.bullets.map((bullet) => (
          <li class="relative pl-5 text-sm leading-relaxed text-[#ecc7bc]/85">
            <span class="absolute left-0 top-[0.55em] h-1 w-1 rounded-full bg-[#e34b3a]" />
            {bullet}
          </li>
        ))}
      </ul>
    </article>
  ))
}
