---
import { CV_PROFILE } from '@/data/cv';
---

<header class="mb-14">
  <h1 class="text-4xl md:text-5xl font-black tracking-tight text-[#ecc7bc]">
    {CV_PROFILE.name}
  </h1>

  <p class="mt-3 text-lg text-[#e34b3a] font-medium">
    <span>{CV_PROFILE.headline}</span>
    {/* Built as one string: Astro collapses the whitespace between an expression
        and an adjacent tag, which swallowed the space before the separator. */}
    <span class="text-[#ecc7bc]/50 font-normal">
      {` · ${CV_PROFILE.alsoKnownAs.join(' · ')}`}
    </span>
  </p>

  <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm list-none p-0 text-[#ecc7bc]/70">
    <li>
      <a href={`mailto:${CV_PROFILE.email}`} class="hover:text-[#e34b3a] transition-colors">
        {CV_PROFILE.email}
      </a>
    </li>
    {
      CV_PROFILE.links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#e34b3a] transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>{CV_PROFILE.location}</li>
  </ul>
</header>
