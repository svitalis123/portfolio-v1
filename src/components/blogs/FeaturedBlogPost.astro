---
import { getInitials, formatPublishDate } from '@/lib/blogDisplay';
import type { BlogListItem } from '@/services/blogMappers';

interface Props {
  blog: BlogListItem;
}

const { blog } = Astro.props;
---

<div class="mb-12 max-w-[1330px] mx-auto px-4 a-fade-up">
  <a href={`/blogs/${blog.slug}`} class="no-underline hover:no-underline">
    <div class="bg-[#2c2824] rounded-lg overflow-hidden">
      <div class="flex flex-col lg:flex-row w-full gap-6">
        <div class="p-6 md:p-8 flex-1 lg:w-3/6 flex flex-col justify-center">
          <div class="space-y-6">
            <span
              class="inline-flex items-center rounded-full bg-[#3d3731] text-gray-100 px-2.5 py-0.5 text-xs font-semibold"
            >
              FEATURED
            </span>

            <h2 class="text-2xl md:text-4xl font-bold text-gray-100 leading-tight">{blog.title}</h2>
            <p class="text-gray-300 text-sm md:text-base">{blog.excerpt}</p>

            <div class="flex items-center space-x-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#3d3731] text-[#000] text-sm font-medium"
              >
                {getInitials(blog.author)}
              </span>

              <div class="flex flex-col">
                <span class="text-gray-100">{blog.author}</span>
                <span class="text-[#fff] text-sm">{formatPublishDate(blog.publishDate)}</span>
              </div>
            </div>
          </div>
        </div>

        {
          blog.coverImage && (
            <div class="h-full lg:w-3/6 relative">
              <img
                src={blog.coverImage}
                alt=""
                loading="eager"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#2c2824] via-transparent to-transparent opacity-50" />
            </div>
          )
        }
      </div>
    </div>
  </a>
</div>
