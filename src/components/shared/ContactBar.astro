---
import { Phone, Linkedin, MessageCircle } from 'lucide-react';

// Three links and a CSS hover label — this was a client:load React island for no
// reason, so it now ships as markup with zero JavaScript.
const CONTACTS = [
  { Icon: MessageCircle, label: 'WhatsApp', href: 'https://wa.me/+254726721982' },
  { Icon: Phone, label: 'Call', href: 'tel:+254726721982' },
  { Icon: Linkedin, label: 'LinkedIn', href: 'https://www.linkedin.com/in/vitalismutwiri/' },
];
---

<nav
  aria-label="Contact"
  class="fixed right-4 top-1/2 -translate-y-1/2 flex flex-col gap-4 z-50"
>
  {
    CONTACTS.map(({ Icon, label, href }) => (
      <div class="relative group flex">
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={label}
          class="p-3 bg-stone-900 text-stone-200 rounded-full transition-all duration-300 hover:scale-110 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
        >
          <Icon size={24} aria-hidden="true" />
        </a>

        <span class="pointer-events-none absolute right-full top-1/2 -translate-y-1/2 mr-2 px-2 py-1 bg-stone-900 text-stone-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
          {label}
        </span>
      </div>
    ))
  }
</nav>
